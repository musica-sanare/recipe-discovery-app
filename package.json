{
  "name": "recipe-discovery",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "npm run content:build && vite",
    "build": "npm run validate:content && npm run content:build && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=desktop-chromium --project=mobile-chromium --project=mobile-webkit",
    "test:e2e:timing": "playwright test --project=timing",
    "check": "npm run lint && npm run typecheck && npm run check:licenses && npm run test && npm run build",
    "check:licenses": "node tools/check-licenses.ts",
    "validate:content": "node tools/validate-content.ts",
    "content:build": "node tools/build-content.ts",
    "report:composition": "node tools/report-composition.ts",
    "data:extract": "node tools/extract-composition.ts",
    "data:verify-cooking": "node tools/verify-cooking-transcription.ts",
    "eval:coverage": "node tools/evaluate-coverage.ts",
    "eval:ai": "node tools/evaluate-ai.ts",
    "bench:recommendation": "node tools/benchmark-recommendation.ts"
  },
  "dependencies": {
    "i18next": "^26.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "fsevents": false
  }
}

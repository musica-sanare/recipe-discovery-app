// Cloudflare Workers static assets, without a Worker script (ADR-001, docs/en/DEPLOYMENT.md).
// Used only for deployments the owner approves. `compatibility_date` is set to the
// deployment date; `assets.directory` resolves relative to this file when it is passed
// with `--config` (verified with `wrangler deploy --dry-run`, docs/working/DECISIONS.md
// "Deployment preparation and dry run").
{
  "name": "recipe-discovery",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "../../dist",
    "not_found_handling": "single-page-application"
  }
}
